---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Privacy policy" description="AI Eval Work Guide privacy policy: a static site with no accounts, no forms and no tracking cookies set by us. What hosting and outbound links may log." path="privacy/">
  <PageHead title="Privacy policy" eyebrow="Legal" />
  <div class="wrap read"><div class="prose">
    <p><strong>Last updated:</strong> 20 Nov 2026</p>
    <ul>
      <li>This is a static website. We don't run accounts, forms, payments or comments, and we don't set tracking or advertising cookies.</li>
      <li>The site is hosted on GitHub Pages. GitHub may log technical data such as IP addresses for security and operations; see GitHub's privacy statement.</li>
      <li>When you click a link to another site (such as a platform's official page), that site's own privacy policy applies.</li>
      <li>If we add analytics or referral tracking in future, we'll update this page first and describe what's collected.</li>
    </ul>
  </div></div>
</Base>
